
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ccvphysicsresearch-source/computational-result-verification/blob/platform-blueprint/schemas/verification-record.schema.json",
  "title": "Computational Verification Record",
  "description": "Structured metadata for a scientific computational reproduction and its evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record",
    "publication",
    "target",
    "verification",
    "methods",
    "evidence",
    "limitations",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "status",
        "created",
        "updated",
        "contributors",
        "reviewers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "status": {
          "enum": [
            "draft",
            "submitted",
            "execution_checked",
            "numerically_cross_checked",
            "independently_reviewed"
          ]
        },
        "created": {
          "type": "string",
          "format": "date"
        },
        "updated": {
          "type": "string",
          "format": "date"
        },
        "contributors": {
          "$ref": "#/$defs/information"
        },
        "reviewers": {
          "$ref": "#/$defs/information"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "authors",
        "year",
        "venue",
        "doi"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "$ref": "#/$defs/information"
        },
        "year": {
          "type": "integer",
          "minimum": 1600,
          "maximum": 2200
        },
        "venue": {
          "$ref": "#/$defs/information"
        },
        "doi": {
          "$ref": "#/$defs/information"
        },
        "publication_url": {
          "$ref": "#/$defs/information"
        },
        "published_code_or_data_url": {
          "$ref": "#/$defs/information"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "scope",
        "reference_results"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "reference_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/information"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_stage",
        "scientific_verdict",
        "verdict_justification"
      ],
      "properties": {
        "workflow_stage": {
          "enum": [
            "submitted",
            "execution_checked",
            "numerically_cross_checked",
            "independently_reviewed"
          ]
        },
        "scientific_verdict": {
          "enum": [
            "reproduced_within_stated_tolerances",
            "partial_numerical_reproduction",
            "inconsistent_with_reference",
            "inconclusive"
          ]
        },
        "verdict_justification": {
          "type": "string",
          "minLength": 1
        },
        "review_scope": {
          "$ref": "#/$defs/information"
        },
        "review_date": {
          "$ref": "#/$defs/information"
        }
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "implementation",
          "independence_assessment"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "original_method",
              "primary_reproduction",
              "cross_check",
              "exploratory"
            ]
          },
          "implementation": {
            "$ref": "#/$defs/information"
          },
          "independence_assessment": {
            "type": "string",
            "minLength": 1
          },
          "settings": {
            "type": "object"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/numerical_result"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "kind",
          "location",
          "status"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "source_code",
              "raw_output",
              "execution_log",
              "comparison_script",
              "reference_data",
              "test",
              "report",
              "other"
            ]
          },
          "location": {
            "$ref": "#/$defs/information"
          },
          "status": {
            "enum": [
              "available",
              "not_yet_confirmed",
              "unavailable",
              "not_applicable"
            ]
          },
          "code_revision": {
            "$ref": "#/$defs/information"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_url",
        "code_revision",
        "environment",
        "execution_instructions"
      ],
      "properties": {
        "repository_url": {
          "$ref": "#/$defs/information"
        },
        "code_revision": {
          "$ref": "#/$defs/information"
        },
        "environment": {
          "$ref": "#/$defs/information"
        },
        "execution_instructions": {
          "$ref": "#/$defs/information"
        },
        "license_and_attribution": {
          "$ref": "#/$defs/information"
        },
        "ai_assistance_disclosure": {
          "$ref": "#/$defs/information"
        }
      }
    }
  },
  "$defs": {
    "information": {
      "description": "A known value or an explicit missing-information status.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "unknown",
                "not_reported",
                "not_applicable",
                "not_yet_confirmed"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        }
      ]
    },
    "numerical_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantity",
        "value",
        "source",
        "comparison_scope"
      ],
      "properties": {
        "quantity": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "unit": {
          "type": "string"
        },
        "source": {
          "enum": [
            "published_reference",
            "computed",
            "derived"
          ]
        },
        "comparison_scope": {
          "type": "string",
          "minLength": 1
        },
        "absolute_error": {
          "type": "number",
          "minimum": 0
        },
        "relative_error": {
          "type": "number",
          "minimum": 0
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
